# TripSync environment — copy to .env and fill in. NEVER commit .env.
# .env is gitignored.

# --- AI providers (server-side fallback chain) -------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Live flight pricing (REQUIRED for "live fare" on results + planner) -----
# Travelpayouts API token. Without it, /api/flight-prices returns
# {"price": null} and the live-price block stays hidden (TripSync still works,
# it just shows AI budget estimates instead of live fares).
TRAVELPAYOUTS_TOKEN=

# --- Optional ----------------------------------------------------------------
# Amadeus credentials are read by the API layer but the live fare fetch uses
# Travelpayouts; Amadeus is only needed if you switch providers.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Google Sheets lead/appendix export (optional)
SPREADSHEET_ID=

# Postgres URL for production (server.py falls back to local SQLite when unset)
DATABASE_URL=

# --- API hardening (all optional, sane defaults) -----------------------------
# Rate-limit storage. "memory://" is per-process and resets on every deploy —
# set a Redis URL to make limits real across restarts/instances.
RATELIMIT_STORAGE_URI=memory://

# How long an identical AI search is served from cache, in seconds (default 6h).
SEARCH_CACHE_TTL=21600

# Enables /api/health (provider + DB readiness). Unset = endpoint 404s.
# Send it as the X-Health-Token header or ?token= query param.
HEALTH_TOKEN=

# Free-tier daily allowance of server-key LLM calls per IP (default 20).
SERVER_KEY_DAILY_LIMIT=20
